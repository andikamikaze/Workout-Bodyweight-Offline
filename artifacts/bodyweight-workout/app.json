{
  "expo": {
    "name": "Gerak",
    "slug": "aplikasi-workout-fitness-plan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/appstore.png",
    "scheme": "bodyweight-workout",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/images/appstore.png",
      "resizeMode": "contain",
      "backgroundColor": "#DEE9BA"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.wildanaesteam.aplikasiworkoutfitnessplan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundColor": "#DEE9BA"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE",
        "VIBRATE",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "foregroundServiceType": "mediaPlayback"
    },
    "web": {
      "favicon": "./assets/images/appstore.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1E5B3A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "1173ccf3-524b-4c5a-bc7b-fa8cf7f960d3"
      }
    }
  }
}
